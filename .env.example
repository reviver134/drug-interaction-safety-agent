# Local FalkorDB defaults. For Cloud, copy values from its Connectivity panel.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=drug_interactions
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Use true only when the database endpoint supports TLS.
FALKORDB_SSL=false

# Optional: manual entry and graph evidence work without Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: absolute directory containing the external source datasets.
# DRUG_DATA_DIR=C:/drug-data

# Keep legacy patient mutation HTTP endpoints disabled for a public demo.
ENABLE_PATIENT_MUTATIONS=false

# RENDER_API_KEY is a local deployment credential, not an app requirement.
# Do not add deployment credentials to Render's application environment.
